# Include all source modules belonging to this library.
-cp src
--macro include("spilehx.core")
--macro exclude("haxe.*")

-D doc-gen
--no-output
-xml docs/types.xml


--next
# --cmd rm -rf docs/api
--cmd haxelib run dox -i docs/types.xml -o docs/api -in "^spilehx$" -in "^spilehx[.]core($|[.])"